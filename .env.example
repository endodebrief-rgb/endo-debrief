# ============================================================
# ENDO DEBRIEF — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS COMMITTER le fichier .env sur GitHub
# ============================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- ElevenLabs ---
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # ID de ta voix clonée

# --- NCBI / PubMed (optionnel mais recommandé) ---
NCBI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # Gratuit sur ncbi.nlm.nih.gov/account/

# --- YouTube ---
YOUTUBE_CLIENT_ID=xxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Meta (Instagram + Facebook) ---
META_APP_ID=xxxxxxxxxxxxxxxxxx
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_PAGE_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_INSTAGRAM_USER_ID=xxxxxxxxxxxxxxxxxx
META_FACEBOOK_PAGE_ID=xxxxxxxxxxxxxxxxxx

# --- TikTok ---
TIKTOK_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TIKTOK_OPEN_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Email (validation avant publication) ---
SMTP_EMAIL=yohann.dabi@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx  # App password Gmail (pas le mot de passe principal)
REVIEW_EMAIL=yohann.dabi@gmail.com

# --- Configuration générale ---
CHANNEL_NAME=Endo Debrief
OUTPUT_DIR=./output
